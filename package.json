{
  "name": "leetcode-backend-helper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "dev:local": "concurrently -n firebase,next -c yellow,cyan \"firebase emulators:start --only auth,firestore\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "firebase:emulators": "firebase emulators:start --only auth,firestore",
    "auth:local-user": "tsx scripts/firebase/local-auth-user.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scrape:crawl4ai": "python3 scripts/scrape/crawl4ai-cli.py",
    "scrape:roadmap-tree": "python3 scripts/scrape/crawl4ai-cli.py --tree",
    "scrape:roadmap-json": "tsx scripts/scrape/roadmap-json.ts",
    "seed:firestore": "tsx scripts/firestore/seed.ts"
  },
  "dependencies": {
    "firebase": "^11.9.0",
    "next": "16.2.4",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^13.31.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
