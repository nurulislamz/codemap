rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All data access goes through server code using the Admin SDK, which
    // bypasses these rules. The web client uses Firebase Auth only, so deny
    // all direct client access to Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
